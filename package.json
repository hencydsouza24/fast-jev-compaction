{
  "name": "fast-jev-compaction",
  "version": "0.3.0",
  "description": "Jev-guided context compaction for Claude Code, Codex, and OpenCode sessions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".claude-plugin",
    ".codex-plugin",
    ".opencode-plugin",
    "hooks"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate .claude-plugin/plugin.json",
    "validate:codex-plugin": "cd .codex-plugin && codex plugin validate .",
    "install:claude": "claude plugin marketplace add hencydsouza24/fast-jev-compaction && claude plugin install fast-jev-compaction",
    "install:codex": "cd .codex-plugin && codex plugin add ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}