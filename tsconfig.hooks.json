{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "claude-code": ["types/claude-code.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "hooks/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "tests", "examples", "demo"]
}